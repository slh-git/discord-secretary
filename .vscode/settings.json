{
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "cSpell.enabled": true,
    "cSpell.words": [
        "autocompletes",
        "autocompleting",
        "bot's",
        "cmds",
        "cooldown",
        "cooldowns",
        "datas",
        "descs",
        "discordbotlist",
        "discordjs",
        "discordlabs",
        "discordlist",
        "disforge",
        "filesize",
        "luxon",
        "millis",
        "Novak",
        "ondiscord",
        "parens",
        "pino",
        "regexes",
        "respawn",
        "respawned",
        "restjson",
        "unescapes",
        "varchar"
    ],
    "typescript.preferences.importModuleSpecifierEnding": "js",
    "workbench.colorCustomizations": {
        "activityBar.background": "#acecfd",
        "titleBar.activeBackground": "#7ae0fc",
        "titleBar.activeForeground": "#15202b",
        "activityBar.activeBackground": "#acecfd",
        "activityBar.foreground": "#15202b",
        "activityBar.inactiveForeground": "#15202b99",
        "activityBarBadge.background": "#fb63db",
        "activityBarBadge.foreground": "#15202b",
        "commandCenter.border": "#15202b99",
        "sash.hoverBorder": "#acecfd",
        "statusBarItem.hoverBackground": "#48d4fb",
        "statusBarItem.remoteBackground": "#7ae0fc",
        "statusBarItem.remoteForeground": "#15202b",
        "titleBar.inactiveBackground": "#7ae0fc99",
        "titleBar.inactiveForeground": "#15202b99",
        "statusBar.background": "#7ae0fc",
        "statusBar.foreground": "#15202b"
    },
    "peacock.color": "#7ae0fc"
}
