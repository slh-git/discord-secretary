# PostgreSQL (used by docker-compose and local API)
POSTGRES_USER=discord_secretary
POSTGRES_PASSWORD=change_me
POSTGRES_DB=discord_secretary
DATABASE_URL=postgresql://discord_secretary:change_me@localhost:5432/discord_secretary

# API
API_HOST=0.0.0.0
API_PORT=3000
API_BASE_URL=http://localhost:3000

# Discord bot (apps/discord) — service key must match on API and Discord app
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_SERVICE_API_KEY=generate_a_random_service_key_here

# Comma-separated Discord user snowflakes allowed to send DMs
DISCORD_DEVELOPER_IDS=123456789012345678

NODE_ENV=development
