DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_id
DISCORD_DEVELOPER_IDS=your_discord_user_id
API_SECRET=00000000-0000-0000-0000-000000000000
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/oauth/callback

# Optional: LLM for calendar / scheduling (Ollama or OpenRouter)
LOCAL_LLM_ENABLED=false

# Provider: ollama (default) or openrouter
LOCAL_LLM_PROVIDER=ollama

# --- Ollama (local) ---
# LOCAL_LLM_MODEL must match `ollama list` exactly (same string as `ollama run <name>`).
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
# LOCAL_LLM_MODEL=gemma45:e2b

# --- OpenRouter (cloud, Gemma 4 free tier) ---
# LOCAL_LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# LOCAL_LLM_MODEL=google/gemma-4-26b-a4b-it:free
# LOCAL_LLM_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://your-site.example
# OPENROUTER_X_TITLE=discord-secretary

LOCAL_LLM_TIMEOUT_MS=300000
LOCAL_LLM_TOOL_MAX_ROUNDS=5
# Optional: lock natural-language scheduling to a specific timezone (IANA name)
# SCHEDULING_TIME_ZONE=America/New_York

# Optional: reminder job queue
REMINDER_JOB_STORE_PATH=data/reminder-jobs.json
REMINDER_JOB_POLL_MS=15000
